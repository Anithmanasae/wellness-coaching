# Copy to .env and adjust. All values are optional; sensible dev defaults apply.

# Database driver: 'sqlite' (default, zero-setup dev) or 'pg' (production).
DB_DRIVER=sqlite
# Required when DB_DRIVER=pg. Use your managed Postgres URL (Supabase/Neon/etc).
DATABASE_URL=postgres://wellness:wellness@localhost:5432/wellness

# Referral tracking.
# Where affiliate links redirect visitors (the coach's course page).
COURSE_URL=https://epiclife.academy/course.asp
# The public base of the affiliate share links (this app's own domain).
REFERRAL_BASE=premium-wellness.club/ref/
# Shared secret the coach's site must send as X-Webhook-Secret on POST /api/conversions.
CONVERSION_SECRET=change-me

# API port.
PORT=4000
